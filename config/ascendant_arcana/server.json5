{
	// Multiplies the base enchantment capacity and all gains by this value. 1.0 is recommended.
	"capacity_multiplier": 1.0,
	// Default relic capacity of an item, recommended is 2 but 1 could provide for more interesting gameplay.
	"base_relic_capacity": 2,
	// XP is by default disabled in Ascendant Arcana, but can be optionally enabled and is fully supported if you do so.
	"disable_xp": true,
	// This can sometimes cause issues with mods that modify the HUD.
	"hide_xp_bar": true,
	// Levels are linear if enabled. This adjusts the XP required to level up each time.
	"xp_per_level": 30,
	// Some vanilla mobs drop relics on death, like Witches, Wither Skeletons, and bosses. Recommended.
	"add_relics_to_entities": true,
	// Relics are automatically added to ANY chest loot table containing an enchanted book. Recommended.
	"add_relics_to_chests": true,
	// Add restorine to any chests containing amethyst shards or diamonds
	"add_restorine_to_chests": true,
	// Add unique boss drops, like the Warden Heart. Disabling this will make some enchantments unobtainable.
	"add_boss_drops": true,
	// The minimum amount of power (bookshelves and enchanted books within range of an enchanting table) to enchant.
	"minimum_enchanting_power": 0,
	// The minimum amount of power required to enchant uncommon enchantments.
	"uncommon_enchanting_power": 22,
	// The minimum amount of power required to enchant rare enchantments.
	"rare_enchanting_power": 55,
	// The minimum amount of power required to enchant very rare enchantments.
	"very_rare_enchanting_power": 100,
	// Enchanted Books can only have one enchantment on them. Otherwise, they use the regular capacity system.
	"single_enchantment_books": true,
	/* Ascendant Arcana disables many vanilla enchantments because they stress the capacity system too much with
	   'required' enchantments. Enchantments are generally meant to be more interesting and meaningfully impactful
	   but this list is configurable so you can enable or disable whatever you want.
	   
	   Do note that most enchantments on this list by default DO NOT come with recipes, so in order to see them in
	   the Enchanting Table you must create your own enchantment recipes for them with a datapack.
	*/
	"disabled_enchantments": [
		"minecraft:bane_of_arthropods",
		"majruszsenchantments:immortality",
		"minecraft:sharpness",
		"majruszsenchantments:gold_fuelled",
		"minecraft:efficiency",
		"minecraft:fire_protection",
		"minecraft:mending",
		"majruszsenchantments:enlightenment",
		"minecraft:power",
		"majruszsenchantments:misanthropy",
		"ascendant_arcana:coldheart",
		"majruszsenchantments:dodge",
		"ascendant_arcana:heart_of_the_storm",
		"minecraft:projectile_protection",
		"minecraft:smite",
		"minecraft:unbreaking",
		"minecraft:quick_charge",
		"minecraft:protection",
		"minecraft:blast_protection",
		"minecraft:impaling",
		"majruszsenchantments:smelter",
		"majruszsenchantments:magic_protection"
	],
	// Items which have their base relic capacity value overwritten.
	"base_relic_capacity_overrides": {
		"minecraft:crossbow": 1
	},
	// Items which have their base enchantment capacity overwritten
	"base_enchantment_capacity_overrides": {
		"minecraft:shield": 15,
		"minecraft:crossbow": 20,
		"minecraft:enchanted_book": 12,
		"minecraft:bow": 20,
		"minecraft:trident": 15
	},
	// Enchantments which have their base rarity overwritten. Common is 1, Uncommon is 2, Rare is 3, Very Rare is 4. This might not work on modded enchantments.
	"overwritten_rarities": {
		"minecraft:knockback": 1,
		"minecraft:thorns": 2,
		"minecraft:sweeping": 2,
		"minecraft:flame": 2,
		"minecraft:looting": 4,
		"minecraft:lure": 1,
		"minecraft:respiration": 2,
		"minecraft:fire_aspect": 2,
		"minecraft:frost_walker": 2,
		"minecraft:infinity": 3,
		"minecraft:punch": 1,
		"minecraft:fortune": 4
	}
}