// ### THE MOD REQUIRES A RESTART OF THE GAME TO APPLY CHANGES ###
{
  // this is the main spread factor (default is 2)
  //
  // tips: a spread factor can be a decimal number (such as 1.5)
  //       a spread factor of 1 means all structure's placements are not modified (useful if you want to use only custom spread factors)
  //       a spread factor above 1 means all structures are rarer
  //       a spread factor below 1 means all structures are more common
  //       a spread factor of 0 disables all structures entirely
  "spreadFactor": 1.15,

  // Some structure mods/datapacks do not specify a custom salt or use the same salt for all their structures, which might cause structure overlap.
  // Enabling this is supposed to reduce this phenomenon, as all structure sets will have their own salt, hashed from their id.
  // If unsure, leave this enabled.
  "idBasedSalt": true,

  "customSpreadFactors": [
    {
      "structure": "fracture:flesh_dungeon",
      "factor": 0.1
    },
    {
      "structure": "bloodyhell:vespers_hut",
      "factor": 1
    },
    {
      "structure": "neepmeat:verrucous_rock",
      "factor": 0.9
    },
    {
      "structure": "vampirism:hunter_camp",
      "factor": 1.4
    },
    {
      "structure": "integrated_villages:airship_village",
      "factor": 1
    },
    {
      "structure": "integrated_villages:cabin_village",
      "factor": 1
    },
    {
      "structure": "integrated_villages:clockwork_village",
      "factor": 1
    },
    {
      "structure": "integrated_villages:kutcha_village",
      "factor": 1
    },
    {
      "structure": "integrated_villages:marketstead_village",
      "factor": 1
    },
    {
      "structure": "integrated_villages:mediterranean_village",
      "factor": 1
    },,
    {
      "structure": "integrated_villages:mossy_mounds",
      "factor": 1
    },,
    {
      "structure": "integrated_villages:oasis_village",
      "factor": 1
    },,
    {
      "structure": "integrated_villages:pirate_village",
      "factor": 1
    },,
    {
      "structure": "integrated_villages:sunken_village",
      "factor": 1
    },,
    {
      "structure": "integrated_villages:tavern_village",
      "factor": 1
    }
  ]
}