		{
			dependencies: ["4E4E81226BED0E7C"]
			description: [
				"\"This seems like a cheap knockoff of the Tower card.\""
				""
				"&c\"No, no, no. This is where the effect of the Tower card originates. Ancient engineers once asked an ancient reliquer king to bring this ability to light.\"&r"
				""
				"\"An ancient reliquerer who was a king?\""
				"{@pagebreak}"
				"&c\"Reliquers were rarer back in the day, you know. They didn't have their massive parties or organized society to collect rare parts as we do.\"&r"
				""
				"\"Don't act as if you were old enough to have lived a thousand years ago.\""
			]
			entity_vis_size: 1.0f
			hide_dependency_lines: true
