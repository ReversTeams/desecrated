		}
		{
			dependencies: ["7D281BDB1C2472F1"]
			description: [
				"Keeping in line with my newfound rudimentary transmutation knowledge, I managed to craft a more expensive but more useful version of the standard Sojourner Staff reliquerers use! They say relics are unique to their wielders, is this a part of it?"
				""
				"The Sojourner Staff is used to place down ethereal torches wherever you go. With my unique model, however, you don't need to keep torches with you!"
				"{@pagebreak}"
				"&cSebastian&r tried replicating my recipe and it didn't work for him, unfortunately. A few other reliquerers also tried their hand and failed. I leave the recipe I used as a note, but beware that this may not work to make the transmutation-unique variant of the Sojourner Staff."
			]
			entity_vis_size: 1.0f
			id: "6FE18A64BEAF0A08"
			rewards: [
				{
					count: 64
					id: "78C6E77E77448199"
					item: "minecraft:torch"
					type: "item"
				}
				{
					id: "1ECA2F3E2A4BF61D"
					type: "xp_levels"
					xp_levels: 1
				}
			]
			tasks: [{
				id: "09C668F3104EE04D"
				item: "reliquary:sojourner_staff"
				type: "item"
			}]
			x: 7.400000000000001d
			y: 13.75d
		}
		{
			dependencies: ["081070F7CBF61207"]
			description: ["&c\"As someone who dabbles in brewing from time to time in order to make specialized ammunition, in the past I had found myself wanting for particular plants that are difficult for me to get more of out in the field. So, I ended up synthesizing this particular relic to help with my supply. It instantaneously grows whatever you're looking at, and if you use it to harvest a crop it simultaneously picks the whole batch as well. Saves me quite a bit of money when I'm looking for more ingredients!\"&r"]
			entity_vis_size: 1.0f
			id: "6D9C35A4B03D6421"
			rewards: [
				{
					id: "5A3A2B4BB54E503C"
					item: "reliquary:fertile_essence"
					type: "item"
				}
				{
					id: "286FCA4ECEF1D7BC"
