			}]
			x: 8.900000000000002d
			y: 16.25d
		}
		{
			dependencies: ["7D281BDB1C2472F1"]
			description: ["&c\"Now this is one of my most powerful artifacts! One cast of the Serpent Staff can easily turn a dicey combat encounter into a cakewalk. Upon being hit by the Kraken's spit expelled by this weapon, your enemies will find themselves completely unable to attack you for a time! Now, this comes with a couple caveats, those being that the staff is exceptionally fragile and that the pacification isn't foolproof. An enemy with a strong will can fight against it, but nine times out of ten you have a free kill.\"&r"]
			entity_vis_size: 1.0f
			id: "1CB0C2CD353BA642"
			rewards: [
				{
					id: "3EEE0193BE713118"
