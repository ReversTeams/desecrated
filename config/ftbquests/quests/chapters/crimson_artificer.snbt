			x: 1.950000000000002d
			y: 14.049999999999999d
		}
		{
			dependencies: ["081070F7CBF61207"]
			description: [
				"&c\"The Emperor's Chalice is one of my more tame creations, merely acting as an infinite source of water. Definitely useful, just not too exciting for my tastes. I personally use it for filling my Apothecary Cauldron and sip from it when I'm thirsty. Just make sure you don't leave it upside down. I didn't appreciate the hit my funds got when I almost flooded an entire district...\"&r"
				"{@pagebreak}"
				"\"But isn't this the same as carrying two buckets of water?\""
				""
				"&c\"What?\"&r"
				""
				"\"You know, laws of physics.\""
			]
			entity_vis_size: 1.0f
			id: "4128B0BDF74E7913"
			rewards: [
				{
					id: "394382D1B424C5C6"
					type: "xp_levels"
					xp_levels: 1
				}
				{
