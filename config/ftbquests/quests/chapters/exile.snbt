		{
			dependencies: ["0CA41706516F60D1"]
			description: ["As sanguines preferred magical and traditional weapons, our manufacturing capabilities are quite underwhelming for firearms. Despite going underground, vampire society still has the ability to produce a few firearms. "]
			entity_vis_size: 1.0f
