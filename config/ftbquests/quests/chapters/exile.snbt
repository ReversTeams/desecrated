							}
							type: "building_kit"
						}
					}
					type: "item"
				}
				{
					id: "3B85FBE1DF1C3BDB"
					type: "xp_levels"
					xp_levels: 1
				}
			]
			subtitle: "The Enchanter"
			tasks: [
				{
					id: "4E70D56F2EFC6421"
					item: "ascendant_arcana:copper_enchanting_table"
					type: "item"
				}
