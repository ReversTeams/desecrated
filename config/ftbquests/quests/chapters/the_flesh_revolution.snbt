		{
			dependencies: ["5D4499D4254102B7"]
			description: [
				"These carcasses are quite cumbersome to carry around. They wouldn't be very useful if I left them in a chest. I should hang them up. Maybe a hook or a rope would do."
				""
				"Cutting them open right there will just cause a mess on the floor. All of the organ, meats and blood will spill on the floor. What a waste! I should prepare something."
			]
			entity_vis_size: 1.0f
			id: "623C14C05294EFCC"
			rewards: [{
				id: "230DCDAECAF7F5D9"
				type: "xp_levels"
				xp_levels: 1
