	order_index: 2
	quest_links: [ ]
	quests: [
		{
			description: [
				"The Sickle of Struggle can appear in the hands of the betrayed guzzler at night."
				""
				"&4It's quite a dangerous foe if caught unprepared. The guzzler can snatch your weapon right out of your hands and leave you completely defenseless. They are rare to encounter at night alone, but be prepared for when it happens."
				""
				"The main issue is recovering an intact sickle when fighting a guzzler. They keep breaking their sickles when I slay them!"
				"{@pagebreak}"
				"This Sickle can extract mystical ingredients from prey quite easily. Killing any monster or animal with a sickle leaves their mystical organs intact. If I have an empty bottle on me, I could try to extract their blood as well. It's sure to be a useful ingredient."
			]
			entity_vis_size: 1.0f
			icon: {
				Count: 1
				id: "sons_of_sins:sickle_of_struggle"
				tag: {
					Damage: 0
				}
			}
			id: "445742EA3F278341"
			rewards: [
				{
