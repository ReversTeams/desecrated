		{
			dependencies: ["0D9BE8A704ED8BB4"]
			description: [
				"&o&7Notes from Eleonore's Travels, Tome IX"
				""
				"&2A strange sword that remains one of the few to open a rift to another dimension that resembles some depictions of Limbo in more religious descriptions.&r"
				"{@pagebreak}"
				"&2Purgatory is a strange place, and seems devoid of life at times. It does contain some materials useful to elementalists, serving as great substitutes in many recipes.&r"
			]
			entity_vis_size: 1.0f
			hide_until_deps_complete: true
			id: "5D06B3DA89CB0B2E"
			rewards: [{
				id: "597ACEAFFBB55A91"
